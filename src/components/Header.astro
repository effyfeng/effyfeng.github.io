---
const { pathname } = Astro.url;
const nav = [
  { href: '/notes/', label: 'Notes' },
  { href: '/journal/', label: 'Journal' },
];
---

<header class="site-header">
  <a class="brand" href="/">Effy Feng</a>
  <nav>
    {nav.map(({ href, label }) => (
      <a href={href} aria-current={pathname.startsWith(href) ? 'page' : undefined}>{label}</a>
    ))}
  </nav>
</header>

<style>
  .site-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding-bottom: 1.25rem;
    margin-bottom: 2rem;
    border-bottom: 3px solid var(--edge);
  }
  .brand {
    position: relative;
    font-family: var(--display);
    font-size: 1.7rem;
    text-decoration: none;
    letter-spacing: 0.02em;
  }
  .brand:hover { background: none; color: var(--c-lip); }
  /* 名字下面一笔上挑的眼线 */
  .brand::after {
    content: "";
    position: absolute;
    left: -2px;
    right: -1.4rem;
    bottom: -0.35rem;
    height: 0.5rem;
    background: var(--fg);
    clip-path: polygon(0 55%, 88% 35%, 100% 0, 92% 75%, 6% 100%);
  }
  nav { display: flex; gap: 0.6rem; font-family: var(--fashion); font-style: italic; font-size: 1.1rem; }
  nav a { text-decoration: none; padding: 0 0.4rem; }
  nav a:hover { background: var(--c-lemon); }
  nav a[aria-current="page"] { background: var(--c-pink); color: var(--c-kohl); }
</style>
