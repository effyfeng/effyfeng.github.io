---
import type { CollectionEntry } from 'astro:content';
import Tag from './Tag.astro';
import { formatDate } from '../lib/date';

interface Props {
  post: CollectionEntry<'notes'> | CollectionEntry<'journal'>;
  base: '/notes' | '/journal';
}
const { post, base } = Astro.props;
---

<li>
  <a class="post-title" href={`${base}/${post.id}/`}>{post.data.title}</a>
  <div class="post-meta">
    <time class="mono muted" datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
    {post.data.tags.map((t) => <Tag name={t} />)}
  </div>
  {post.data.description && <p class="muted" style="margin: 0.4rem 0 0">{post.data.description}</p>}
</li>
