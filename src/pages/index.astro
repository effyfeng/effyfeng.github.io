---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';

// 首页：一句话介绍 + 最近的几篇
const byDateDesc = (a: { data: { date: Date } }, b: { data: { date: Date } }) =>
  b.data.date.valueOf() - a.data.date.valueOf();

const notes = (await getCollection('notes', ({ data }) => !data.draft)).sort(byDateDesc).slice(0, 5);
const journal = (await getCollection('journal', ({ data }) => !data.draft)).sort(byDateDesc).slice(0, 5);
---

<Base title="Effy Feng">
  <p>
    I am a software engineer. This is where I keep what I learn and what I cook.
  </p>

  <h2>Recent notes</h2>
  <ul class="post-list">
    {notes.map((post) => <PostCard post={post} base="/notes" />)}
  </ul>
  <p><a href="/notes/">All notes →</a></p>

  <h2>Journal</h2>
  <ul class="post-list">
    {journal.map((post) => <PostCard post={post} base="/journal" />)}
  </ul>
  <p><a href="/journal/">All entries →</a></p>
</Base>
