---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';

// 一个 tag 一个网址：/tags/art/ 列出 notes 和 journal 里所有带这个 tag 的文章
export async function getStaticPaths() {
  const notes = await getCollection('notes', ({ data }) => !data.draft);
  const journal = await getCollection('journal', ({ data }) => !data.draft);
  const tags = new Set([...notes, ...journal].flatMap((p) => p.data.tags));
  return [...tags].map((tag) => ({
    params: { tag },
    props: {
      notes: notes.filter((p) => p.data.tags.includes(tag)),
      journal: journal.filter((p) => p.data.tags.includes(tag)),
    },
  }));
}

const { tag } = Astro.params;
const { notes, journal } = Astro.props;
const byDateDesc = (a: { data: { date: Date } }, b: { data: { date: Date } }) =>
  b.data.date.valueOf() - a.data.date.valueOf();
---

<Base title={`#${tag}`} description={`Everything tagged ${tag}`}>
  <h1 class="mono">#{tag}</h1>

  {journal.length > 0 && (
    <>
      <h2>Journal</h2>
      <ul class="post-list">
        {journal.sort(byDateDesc).map((post) => <PostCard post={post} base="/journal" />)}
      </ul>
    </>
  )}

  {notes.length > 0 && (
    <>
      <h2>Notes</h2>
      <ul class="post-list">
        {notes.sort(byDateDesc).map((post) => <PostCard post={post} base="/notes" />)}
      </ul>
    </>
  )}
</Base>
